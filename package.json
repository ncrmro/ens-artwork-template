{
  "name": "ens-artwork-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run contracts:compile && next build",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "node scripts/compile.mjs",
    "test": "tsx --test tests/*.test.ts",
    "deploy": "npm run configure && npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "test:browser": "node scripts/browser.mjs",
    "test:wallet": "tsx scripts/browser-wallet.ts",
    "configure": "node scripts/configure.mjs",
    "build:web": "next build",
    "local:prepare": "node scripts/local/prepare.mjs",
    "local:chain": "node scripts/local/chain.mjs",
    "local:dev": "LOCAL_CHAIN=1 node scripts/dev.mjs",
    "local:fixtures": "node scripts/local/fixtures.mjs",
    "local:verify": "node scripts/local/verify.mjs",
    "local:verify:policy": "node scripts/local/verify-policy.mjs",
    "test:story": "node scripts/browser-story.mjs",
    "seed:check": "node scripts/seed/sepolia.mjs",
    "seed:sepolia": "node scripts/seed/sepolia.mjs --apply",
    "seed:assets": "node scripts/seed/generate-assets.mjs",
    "seed:verify": "node scripts/seed/verify-local.mjs",
    "seed:verify:admin": "node scripts/seed/verify-admin.mjs",
    "test:admin": "node scripts/browser-admin.mjs",
    "seed:assets:named": "node scripts/seed/named-assets.mjs",
    "seed:pin": "node scripts/seed/pin-assets.mjs"
  },
  "dependencies": {
    "multiformats": "latest",
    "next": "^16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-viem": "3.0.9",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "hardhat": "3.18.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.9",
    "solc": "0.8.37",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.139.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
